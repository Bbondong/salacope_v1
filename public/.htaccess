# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# PROTECTION DU DOSSIER ADMIN/BACKEND
# Bloquer l'accès direct au dossier admin
RewriteCond %{REQUEST_URI} ^/admin(/|$) [NC]
RewriteCond %{HTTP_REFERER} !^https?://%{HTTP_HOST}/ [NC]
RewriteRule ^ - [F,L]

# Bloquer l'accès aux fichiers PHP dans admin sans autorisation
RewriteCond %{REQUEST_URI} \.php$
RewriteCond %{REQUEST_URI} ^/admin/ [NC]
RewriteCond %{HTTP_COOKIE} !admin_logged_in=true [NC]
RewriteRule ^ - [F,L]

# PROTECTION DU DOSSIER BACKEND (si différent de admin)
RewriteCond %{REQUEST_URI} ^/backend(/|$) [NC]
RewriteCond %{HTTP_REFERER} !^https?://%{HTTP_HOST}/ [NC]
RewriteRule ^ - [F,L]

# DÉSACTIVER LE CACHE pour les fichiers critiques
<FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# Désactiver le cache pour les pages de login/admin
<If "%{REQUEST_URI} =~ m#(login|admin|backend/auth)#">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</If>

# Activer le cache seulement pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # CSS et JS - version courte pour le dev
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Autres
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain text/xml application/json
</IfModule>

# Sécurité
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"

# Protection contre le clickjacking
Header always append X-Frame-Options SAMEORIGIN

# Désactiver l'indexation des dossiers
Options -Indexes

# Empêcher l'accès aux dossiers spécifiques
RedirectMatch 403 ^/admin/?$
RedirectMatch 403 ^/backend/?$
RedirectMatch 403 ^/includes/?$
RedirectMatch 403 ^/config/?$

# Protéger les fichiers sensibles
<FilesMatch "\.(env|log|sql|yml|yaml|ini|conf|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protéger les fichiers PHP spécifiques
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

<Files "database.php">
    Order allow,deny
    Deny from all
</Files>

<Files "credentials.php">
    Order allow,deny
    Deny from all
</Files>

# Bloquer l'accès aux fichiers de sauvegarde/temporaires
<FilesMatch "\.(bak|backup|old|temp|tmp|swp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirection pour les erreurs
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# Empêcher l'exécution de PHP dans certains dossiers
<Directory "/admin/uploads">
    php_flag engine off
    <FilesMatch "\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</Directory>

<Directory "/backend/uploads">
    php_flag engine off
    <FilesMatch "\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</Directory>